---
import Layout from "../layouts/Layout.astro";
import FileList from "../components/FileList.astro";
import Modal from "../components/Modal.astro"
import UploadIcon from "../static/upload.svg"
import "../styles/dashboard.css"
---

<Layout>
  <div class="main-content" id="dashboard">
    <h1 class="h">Dashboard</h1>
    <button id="openBtn" data-open-modal="upload-modal"><UploadIcon width=24px height=24px class="upload-icon"/></button>
<Modal/>
    <FileList />
  </div>
</Layout>
<script>
document.querySelectorAll<HTMLButtonElement>("[data-open-modal]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const dialog = document.getElementById(btn.dataset.openModal!) as HTMLDialogElement | null;
    dialog?.showModal();
  })
})

</script>
