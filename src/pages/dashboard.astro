---
import Layout from "../layouts/Layout.astro";
import Upload from "../components/Upload.astro";
import FileList from "../components/FileList.astro";
---

<Layout>
  <div class="main-content" id="dashboard">
    <h1 class="h">Dashboard</h1>

    <FileList />
  </div>
  <div id="upload-div">
    <h3>Upload Files</h3>
    <Upload />
  </div>
</Layout>

<style>
  #upload-div {
    /*center the div */
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 3px dotted var(--color-text);
    margin-top: 20px;
  }
  .main-content {
    background: white;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.09);
    padding: 28px;
    margin: 24px auto;
    max-width: 95vw;
    /* padding-bottom: ; */
  }
  .h {
    margin-top: 0;
    font-size: 2.5rem;
    margin-bottom: 20px;
    text-align: center;
    color: #0e1b1d;
  }
  #dashboard {
    width: 100%;
    background-color: white;
    /* border: 4px solid var(--color-primary-dark); */
    margin-bottom: 0;
  }
  body {
    background-color: #f1f5f4;
  }
</style>
<script></script>
