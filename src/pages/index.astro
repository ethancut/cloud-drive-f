---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
    <div class="hero" id="hero" hidden>
        <h1>Welcome!</h1>
        <p>Your files, organized and accessible from anywhere.</p>
        <div class="cta" id="cta">
            <a href="/register" class="btn btn-primary">Sign up free</a>
            <a href="/login" class="btn btn-secondary">Log in</a>
        </div>

        <div class="features" id="features">
            <div class="feature">
                <h3>Upload anything</h3>
                <p>Store documents, images, and files in one place.</p>
            </div>
            <div class="feature">
                <h3>Stay organized</h3>
                <p>Sorting makes it easy to find what you need.</p>
            </div>
            <div class="feature">
                <h3>Access anywhere</h3>
                <p>Your files, available on any device, anytime.</p>
            </div>
        </div>
    </div>

    <div class="hero" id="auth-hero" hidden>
        <h1 id="welcome"></h1>
        <p>Jump back into your files.</p>
        <div class="cta">
            <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
        </div>
    </div>
</Layout>
<script>
    import { getAccessToken, getRefreshToken } from "../utils/auth";

    const hero = document.getElementById("hero") as HTMLElement;

    const username = localStorage.getItem("username");
    const authHero = document.getElementById("auth-hero") as HTMLElement;
    const welcomeEl = document.getElementById("welcome") as HTMLElement;

    const isAuthorized = Boolean(getAccessToken() && getRefreshToken());
    if (username && isAuthorized) {
        welcomeEl.textContent = `Welcome, ${username}!`;
        authHero.hidden = false;
    } else {
        hero.hidden = false;
    }
</script>
<style>
    .hero {
        margin: 3rem 1rem;
        text-align: center;
    }
    .hero h1 {
        font-size: 2.5rem;
    }
    .hero p {
        color: var(--color-text);
        margin-top: 0.5rem;
    }
    .cta {
        margin-top: 1.5rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
    }
    .btn {
        padding: 0.6rem 1.4rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
    }
    .btn-primary {
        background: var(--color-primary-dark);
        color: white;
    }
    .btn-secondary {
        background: #eee;
        color: var(--color-text);
    }
    .features {
        display: flex;
        gap: 2rem;
        justify-content: center;
        margin: 2rem 1rem;
        flex-wrap: wrap;
    }
    .feature {
        max-width: 220px;
        text-align: center;
    }
    .feature h3 {
        margin-bottom: 0.5rem;
    }
</style>
