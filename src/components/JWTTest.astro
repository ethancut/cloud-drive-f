<button id="button">Test JWT</button>

<script>
    document.getElementById("button")?.addEventListener("click", async () => {
        const response = await fetch("http://localhost:8080/api/test-jwt", {
            method: "GET",
            headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("token"),
            },
        });

        if (response.ok) {
            const result = await response.text();
            console.log(result);
            alert("JWT is valid!");
        } else {
            const message = await response.text();
            alert("JWT is invalid: " + message);
        }
    });
</script>
