---
import { formatSize } from "../utils/formatSize";
---

<table id="file-list-table">
    <thead>
        <tr>
            <th>Filename</th>
            <th>Size</th>
            <th>Last Modified</th>
        </tr>
    </thead>
    <tbody id="file-list-body">
        <!-- rows dynamically inserted here -->
        <!-- <tr><td>example.txt</td><td>1 KB</td><td>2023-01-01</td></tr> -->
    </tbody>
</table>

<style>
    #file-list-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    :global(#file-list-table th, #file-list-table td) {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
    }

    #file-list-table th {
        background-color: #f2f2f2;
    }
    #file-list-body {
        text-align: left;
    }
    .file-list {
        max-height: 300px;
        overflow-y: auto;
        text-align: left;
    }
    #fileList {
        display: flex;
        flex-direction: column;
    }
    .file-table-entry {
        display: flex;
        justify-content: space-between;
        padding: 8px;
        border-bottom: 1px solid #ddd;
        border-right: 1px solid #ccc;
    }
</style>

<script>
    import { formatSize } from "../utils/formatSize";

    let fileList = document.getElementById(
        "file-list-body",
    ) as HTMLTableSectionElement;
    async function fetchFiles() {
        const token = localStorage.getItem("token");
        const fileTable = document.getElementById(
            "file-list-body",
        ) as HTMLTableSectionElement;
        if (!token) {
            console.error("No token found in localStorage");
            return;
        }
        try {
            const response = await fetch(
                "http://localhost:8080/api/files/list",
                {
                    headers: {
                        Authorization: `Bearer ${token}`,
                    },
                },
            );
            const data = await response.json();
            for (const file of data.files) {
                console.log(
                    "Name:",
                    file.filename,
                    "Size:",
                    formatSize(file.size),
                );
                const fileRow = document.createElement("tr");
                const NameCell = document.createElement("td");
                const SizeCell = document.createElement("td");
                const ModTimeCell = document.createElement("td");

                NameCell.colSpan = 1;
                NameCell.textContent = file.filename;

                SizeCell.colSpan = 1;
                SizeCell.textContent = formatSize(file.size);

                ModTimeCell.colSpan = 1;
                const date = new Date(file.modtime);
                ModTimeCell.textContent = date.toLocaleDateString();

                fileRow.appendChild(NameCell);
                fileRow.appendChild(SizeCell);
                fileRow.appendChild(ModTimeCell);

                fileTable?.appendChild(fileRow);
            }
        } catch (error) {
            console.error("Error fetching file list:", error);
            return;
        }
    }

    fetchFiles().then(() => {
        if (fileList.children.length === 0) {
            const noFilesRow = document.createElement("tr");
            const noFilesCell = document.createElement("td");
            noFilesCell.colSpan = 3;
            noFilesCell.textContent = "No files found";
            noFilesRow.appendChild(noFilesCell);
            fileList.appendChild(noFilesRow);
        }
    });
</script>
