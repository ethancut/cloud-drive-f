---
import { formatSize } from "../utils/formatSize";
import "../styles/filelist.css";
---

<div class="modal" id="file-preview" style="display: none;">
  <div class="modal-content">
    <img style=" max-width:400px; border:1px solid #000;" />
    <button>X</button>
  </div>
</div>
<table id="file-list-table">
  <thead>
    <tr>
      <th colspan="3">Filename</th>
      <th colspan="1">Size</th>
      <th colspan="2">Last Modified</th>
    </tr>
  </thead>
  <tbody id="file-list-body">
    <!-- rows dynamically inserted here -->
  </tbody>
</table>

<script>
  import "../scripts/filelist.ts";
</script>
