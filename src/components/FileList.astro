---
import "../styles/filelist.css";
---

<div class="modal" id="file-preview" style="display: none;">
  <div class="modal-content">
    <img style=" max-width:400px; border:1px solid #000;" />
    <button>X</button>
  </div>
</div>

<dialog id="rename-modal">
  <form id="rename-form" method="dialog">
    <h2>Rename file</h2>
    <label>
      New name
      <input type="text" name="name" required maxlength="255" />
    </label>
    <div class="actions">
      <button type="button" id="rename-cancel">Cancel</button>
      <button type="submit">Save</button>
    </div>
  </form>
</dialog>
<table id="file-list-table">
  <thead>
    <tr>
      <th data-header="Filename">Filename</th>
      <th data-header="Size">Size</th>
      <th data-header="Last Modified">Last Modified</th>
    </tr>
  </thead>
  <tbody id="file-list-body">
    <!-- rows dynamically inserted here -->
  </tbody>
</table>

<script>
  import "../scripts/files/main.ts";
</script>
