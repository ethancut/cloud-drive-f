---
import Register from "./Register.astro";
import "../styles/header.css";
---

<!-- if logged in, hide login/register buttons and display logout button. -->
<header class="header" id="header">
  <div class="header__content">
    <h1 class="header__title">EDrive</h1>
    <nav class="header__nav">
      <ul class="header__nav-list">
        <li class="header__nav-item"><a href="/">Home</a></li>
        <li class="header__nav-item"><a href="/about">About</a></li>
        <li class="header__nav-item"><a href="/contact">Contact</a></li>
        <li class="header__nav-item"><a href="/login">Login</a></li>
        <li class="header__nav-item">
          <Register />
          <button id="open-register">Register</button>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script>
  document.getElementById("open-register")?.addEventListener("click", () => {
    if (
      document.getElementById("register")?.style.getPropertyValue("display") ===
      "block"
    ) {
      document.getElementById("register")?.style.setProperty("display", "none");
    } else {
      document
        .getElementById("register")
        ?.style.setProperty("display", "block");
    }
  });
</script>
