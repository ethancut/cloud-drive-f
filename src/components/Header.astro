---
import "../styles/header.css";
import CloudIcon from "../static/cloud.svg";
---

<header class="header" id="header">
  <div class="header__container">
    <a href="/" class="header__title"
      ><CloudIcon class="header__logo" />
      <span class="header__name">Drive</span></a
    >
    <nav class="header__nav">
      <ul class="header__nav-list">
        <li><a class="nav-link" href="/">Home</a></li>
        <li><a class="nav-link" href="/about">About</a></li>
        <li><a class="nav-link" href="/contact">Contact</a></li>
      </ul>
    </nav>
    <div class="header__actions">
      <a href="/login" class="nav-link auth-guest">Login</a>
      <a href="/register" class="nav-link auth-guest">Register</a>

      <!-- hidden by default -->
      <a href="/dashboard" class="nav-link auth-user" id="dashboard-btn" hidden
        >Dashboard</a
      >
      <button type="button" class="btn auth-user" id="logout-btn" hidden
        >Logout</button
      >
    </div>
  </div>
</header>

<script>
  import {
    clearTokens,
    getAccessToken,
    getRefreshToken,
    redirectToLogin,
  } from "../utils/auth";

  const isAuthenticated = Boolean(getRefreshToken() && getAccessToken());
  if (isAuthenticated) {
    document.querySelectorAll(".auth-guest").forEach((el) => {
      (el as HTMLElement).hidden = true;
    });

    const dashboardButton = document.getElementById("dashboard-btn");
    const logoutBtn = document.getElementById("logout-btn");

    if (dashboardButton) dashboardButton.hidden = false;
    if (logoutBtn) {
      logoutBtn.hidden = false;
      logoutBtn.addEventListener("click", () => {
        clearTokens();
        redirectToLogin();
      });
    }
  }
</script>
