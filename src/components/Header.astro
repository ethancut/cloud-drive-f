---
import Register from "./Register.astro";
import "../styles/header.css";
const showRegister = true;
import CloudIcon from "../static/cloud.svg";
---

<header class="header" id="header">
  <div class="header__content">
    <h1 class="header__title">
      <span style="position: relative; display: flex; align-items: center;">
        <CloudIcon
          style="height: 1.4em; width: 1.4em; position: absolute; left: 0;"
        />
      </span>
      <span style="padding-left: 1.2em;">
        <a href="/" style="text-decoration: none; color:inherit; ">Drive </a>
      </span>
    </h1>
    <nav class="header__nav">
      <ul class="header__nav-list">
        <li class="header__nav-item"><a href="/">Home</a></li>
        <li class="header__nav-item"><a href="/about">About</a></li>
        <li class="header__nav-item"><a href="/contact">Contact</a></li>
        <li class="header__nav-item"><a href="/login">Login</a></li>
        <li class="header__nav-item"><a href="/register">Register</a></li>
        <li class="header__nav-item" id="dashboard-btn">
          <a href="/dashboard">Dashboard</a>
        </li>
        <li class="header__nav-item" id="logout-btn">
          <button class="logout-btn">Logout</button>
        </li>
      </ul>
    </nav>
  </div>
</header>
<style>
  #logout-btn {
    display: none;
  }
  #dashboard-btn {
    display: none;
  }
  .header__title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .header__title svg {
    fill: white;
  }
</style>
<script>
  if (localStorage.getItem("token")) {
    document.querySelectorAll(".header__nav-item").forEach((item) => {
      const text = item.textContent?.trim();

      if (text === "Login" || text === "Register") {
        (item as HTMLElement).style.display = "none";
      }
    });

    const dashboardButton = document.getElementById(
      "dashboard-btn",
    ) as HTMLLIElement;
    dashboardButton.style.display = "block";

    const logoutBtn = document.getElementById("logout-btn") as HTMLLIElement;
    logoutBtn.style.display = "block";

    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("token");
      window.location.reload();
    });
  }
</script>
